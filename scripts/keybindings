# Keys inside the darshan screen, for Vayu's keybinding search
# (keybind-search.py reads ~/.tmux/plugins/*/scripts). Generated from
# the keymap by `go test ./internal/tui -update`; don't edit.
# keybind-group: Tmux/darshan | Space g | Go to
# keybind-group: Tmux/darshan | Space b | File
# keybind-group: Tmux/darshan | Space f | Find
# keybind-group: Tmux/darshan | Space u | Toggles
# keybind-group: Tmux/darshan | Space o | Open
# keybind-group: Tmux/darshan | Space y | Copy
# keybind: Tmux/darshan:normal | j / Down | Move down (the next page once the page is all shown; 5j repeats)
# keybind: Tmux/darshan:normal | k / Up | Move up (the previous page once the page is all shown)
# keybind: Tmux/darshan:normal | h / Left | Move left when zoomed (else the previous page)
# keybind: Tmux/darshan:normal | l / Right | Move right when zoomed (else the next page)
# keybind: Tmux/darshan:normal | J / PgDn | Move to the next page
# keybind: Tmux/darshan:normal | K / PgUp | Move to the previous page
# keybind: Tmux/darshan:normal | Ctrl+d | Scroll half a screen down
# keybind: Tmux/darshan:normal | Ctrl+u | Scroll half a screen up
# keybind: Tmux/darshan:normal | Ctrl+f | Scroll a screen down (Space did this before it became the leader)
# keybind: Tmux/darshan:normal | Ctrl+b | Scroll a screen up
# keybind: Tmux/darshan:normal | g g / Home | Jump to the first page (5gg: page 5)
# keybind: Tmux/darshan:normal | G / End | Jump to the last page (5G: page 5)
# keybind: Tmux/darshan:normal | : / Space g p | Jump to a page (or line) by number: :12 (also :q, :bd, :e FILE)
# keybind: Tmux/darshan:normal | / | Search the document's text
# keybind: Tmux/darshan:normal | n | Jump to the next match
# keybind: Tmux/darshan:normal | N | Jump to the previous match
# keybind: Tmux/darshan:normal | + | Grow the zoom
# keybind: Tmux/darshan:normal | - | Shrink the zoom
# keybind: Tmux/darshan:normal | = | Reset to fit the whole page
# keybind: Tmux/darshan:normal | [ / Space b p | Switch to the previous file in the folder
# keybind: Tmux/darshan:normal | ] / Space b n | Switch to the next file in the folder
# keybind: Tmux/darshan:normal | Space b d | Close the file (the popup then finds another)
# keybind: Tmux/darshan:normal | f / o / Ctrl+p / Space f f | Search for a file on the whole system (with a preview)
# keybind: Tmux/darshan:normal | Space k | Open the talk with the agent that opened this file, to ask it something
# keybind: Tmux/darshan:normal | z / Space u z | Toggle zen mode: the full screen, nothing but the page
# keybind: Tmux/darshan:normal | Space u i | Invert the colours of pages and pictures (dark mode)
# keybind: Tmux/darshan:normal | Space u w | Toggle fitting the page's width
# keybind: Tmux/darshan:normal | Space o b | Open the file in the desktop's own viewer (xdg-open)
# keybind: Tmux/darshan:normal | Space o e | Open the file in $EDITOR (Markdown)
# keybind: Tmux/darshan:normal | r / Space r | Reload the file (it also reloads by itself when it changes)
# keybind: Tmux/darshan:normal | y / Space y p | Copy the file's path
# keybind: Tmux/darshan:normal | ? / Space ? | Show every key
# keybind: Tmux/darshan:normal | Space Space | Search every action and run one (the palette)
# keybind: Tmux/darshan:normal | q / Space q | Close the popup; the file stays open for next time (the popup's own key too)
# keybind: Tmux/darshan finder:insert | Enter | Open the picked file
# keybind: Tmux/darshan finder:insert | Ctrl+j / Down / Ctrl+n | Move to the next result while typing
# keybind: Tmux/darshan finder:insert | Ctrl+k / Up / Ctrl+p | Move to the previous result while typing
# keybind: Tmux/darshan finder:insert | Tab / Shift+Tab | Switch between all files, PDFs, images and Markdown
# keybind: Tmux/darshan finder:insert | Esc | Leave typing (NORMAL: j, k, g g, G, Ctrl+d / Ctrl+u move; i, a or / type again; Esc or q closes)
# keybind: Tmux/darshan talk:insert | Enter | Send your question, with what's on screen, to the agent
# keybind: Tmux/darshan talk:insert | Esc | Close the talk
# keybind: Tmux/darshan:command | Enter | Run the search or the : command
# keybind: Tmux/darshan:command | Esc | Cancel the search or the : command
